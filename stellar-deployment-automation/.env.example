# Stellar Account Configuration
# Tu clave secreta de Stellar (REQUERIDA para firmar transacciones)
STELLAR_SECRET_KEY=S...TU_SECRET_KEY_AQUI

# Configuración del Deployer Service
# URL del servicio de deployment
DEPLOYER_SERVICE_URL=https://api.example.com/deployer

# Configuración del Contrato
# Dirección del signer (típicamente tu clave pública)
SIGNER_ADDRESS=G...TU_CLAVE_PUBLICA_AQUI

# Dirección del proveedor de servicios
SERVICE_PROVIDER_ADDRESS=G...SERVICE_PROVIDER_ADDRESS_AQUI

# Dirección de la plataforma
PLATFORM_ADDRESS=G...PLATFORM_ADDRESS_AQUI

# Configuración de Red Stellar
# URL del servidor RPC de Soroban
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase para testnet
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Configuración Opcional
# Habilitar validación en Stellar Expert (true/false)
ENABLE_STELLAR_EXPERT_VALIDATION=true

# URL base de Stellar Expert
STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
